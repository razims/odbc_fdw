# Copy this file to .env. .env is deliberately gitignored. Do not commit a
# tenant hostname, schema, user or password. The HANA client is baked into the
# Docker development image from a version and digests pinned in Dockerfile.

HANA_HOST=replace-me
HANA_PORT=30015
HANA_DATABASE=replace-me
HANA_USER=replace-me
HANA_PASSWORD=replace-me

# A known, read-only probe table and one value that proves correct data binding.
HANA_SCHEMA=replace-me
HANA_TABLE=replace-me
HANA_VALUE_COLUMN=replace-me
HANA_EXPECTED_ROW_COUNT=1
HANA_EXPECTED_VALUE=replace-me

HANA_ENCRYPT=true
