# Copy this file to .env. .env is deliberately gitignored. Do not commit a
# tenant hostname, schema, user or password. The HANA client is baked into the
# development image and Oracle Instant Client into its dedicated test stage;
# both versions and all archive digests are pinned in Dockerfile.

HANA_HOST=replace-me
HANA_PORT=30015
HANA_DATABASE=replace-me
HANA_USER=replace-me
HANA_PASSWORD=replace-me

# The comprehensive suite seeds only ODBC_FDW_* tables in this existing schema.
# It never drops or creates a schema.
HANA_SCHEMA=replace-me

HANA_ENCRYPT=true

# Optional bulk transfer gate. Unset means the fixture is not seeded and the
# probe reports the check as skipped. Set it to a row count -- 1000000 is the
# size that makes a per-row leak visible -- to seed ODBC_FDW_BULK and have the
# probe pull it twice, watching the backend's resident set across the two
# passes. Expect the probe to take minutes rather than seconds when it is set.
# HANA_BULK_ROWS=1000000

# Oracle Database 19c multitenant probe. ORACLE_SERVICE must be the PDB's
# service name, not the CDB SID. Use a dedicated test account whose schema can
# contain the ODBC_FDW_* fixtures. The session-leak gate also needs this
# least-privilege grant from a DBA (SELECT_CATALOG_ROLE is a broader alternative):
#   GRANT SELECT ON V_$SESSION TO <ORACLE_USER>;
ORACLE_HOST=replace-me
ORACLE_PORT=1521
ORACLE_SERVICE=replace-me
ORACLE_USER=replace-me
ORACLE_PASSWORD=replace-me
ORACLE_SCHEMA=replace-me

# Optional Oracle bulk transfer gate; same semantics as HANA_BULK_ROWS.
# ORACLE_BULK_ROWS=1000000
